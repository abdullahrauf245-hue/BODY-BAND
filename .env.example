# Copy this file to .env and put your own key after the = sign.
# Get a key at https://physiology.presagetech.com/
# .env is private: it is ignored by git and never uploaded.
PRESAGE_API_KEY=

# Optional
# How long one camera session may run, in seconds (default 120).
# PRESAGE_MAX_SECONDS=120
# Camera mode asked of the webcam (default 640x480@30). Try 1280x720@30 on a good webcam.
# PRESAGE_CAMERA=640x480@30
# Read a specific webcam, for example a phone used as a webcam: part of its name.
# Run "npm run cameras" to see the names. If it is not connected, a session refuses to start.
# PRESAGE_CAMERA_NAME=
